@database :memory:

# Ported from ext/rtree/rtree1.test rtree-8.*: constrained scans of r-tree data.
# These exercise the leaf_constraint logic in xFilter.

setup rtree-constrained {
    CREATE VIRTUAL TABLE t6 USING rtree(ii, x1, x2);
    INSERT INTO t6 VALUES(1, 3, 7);
    INSERT INTO t6 VALUES(2, 4, 6);
}

# x1 > N
@setup rtree-constrained
test x1-gt-2 {
    SELECT ii FROM t6 WHERE x1>2 ORDER BY ii;
}
expect {
    1
    2
}

@setup rtree-constrained
test x1-gt-3 {
    SELECT ii FROM t6 WHERE x1>3 ORDER BY ii;
}
expect {
    2
}

@setup rtree-constrained
test x1-gt-4 {
    SELECT ii FROM t6 WHERE x1>4 ORDER BY ii;
}
expect {
}

# x1 >= N
@setup rtree-constrained
test x1-ge-3 {
    SELECT ii FROM t6 WHERE x1>=3 ORDER BY ii;
}
expect {
    1
    2
}

@setup rtree-constrained
test x1-ge-4 {
    SELECT ii FROM t6 WHERE x1>=4 ORDER BY ii;
}
expect {
    2
}

# x1 < N
@setup rtree-constrained
test x1-lt-4 {
    SELECT ii FROM t6 WHERE x1<4 ORDER BY ii;
}
expect {
    1
}

@setup rtree-constrained
test x1-lt-5 {
    SELECT ii FROM t6 WHERE x1<5 ORDER BY ii;
}
expect {
    1
    2
}

# x1 <= N
@setup rtree-constrained
test x1-le-3 {
    SELECT ii FROM t6 WHERE x1<=3 ORDER BY ii;
}
expect {
    1
}

@setup rtree-constrained
test x1-le-4 {
    SELECT ii FROM t6 WHERE x1<=4 ORDER BY ii;
}
expect {
    1
    2
}

# x1 = N
@setup rtree-constrained
test x1-eq-3 {
    SELECT ii FROM t6 WHERE x1=3 ORDER BY ii;
}
expect {
    1
}

@setup rtree-constrained
test x1-eq-4 {
    SELECT ii FROM t6 WHERE x1=4 ORDER BY ii;
}
expect {
    2
}

@setup rtree-constrained
test x1-eq-2 {
    SELECT ii FROM t6 WHERE x1=2 ORDER BY ii;
}
expect {
}

# NULL handling: x1 > NULL yields no rows (NULL is not comparable).
@setup rtree-constrained
test x1-gt-null {
    SELECT ii FROM t6 WHERE x1>NULL ORDER BY ii;
}
expect {
}

# Multiple constraints on different columns.
# Row 1 has x1=3, x2=7: x1>2 true, x2<7 false (7 is not < 7) → excluded.
# Row 2 has x1=4, x2=6: x1>2 true, x2<7 true → included.
@setup rtree-constrained
test x1-gt-2-and-x2-lt-7 {
    SELECT ii FROM t6 WHERE x1>2 AND x2<7 ORDER BY ii;
}
expect {
    2
}
